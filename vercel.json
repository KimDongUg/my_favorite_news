{
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "myfavoritenews.vercel.app" }],
      "destination": "https://articlemovie.com/$1",
      "permanent": true
    },
    { "source": "/privacy", "destination": "/privacy.html", "permanent": true },
    { "source": "/terms", "destination": "/terms.html", "permanent": true },
    { "source": "/copyright", "destination": "/copyright.html", "permanent": true },
    { "source": "/contact", "destination": "/feedback.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api|.*\\.html$|ads\\.txt$).*)", "destination": "/index.html" }
  ]
}
